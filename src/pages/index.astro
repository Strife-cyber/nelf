---
export const prerender = false;

import '../styles/global.css';
import Layout from '@/layouts/Layout.astro';
import nelfLogo from '@/assets/nelf-logo.jpeg';
import LaserFlow from '@/components/LaserFlow';
import Gallery from '@/components/Gallery.astro';
import SplashCursor from '@/components/SplashCursor';
import RotatingText from '@/components/RotatingText';
import ServiceSidebar from '@/components/ServiceSidebar';
import { 
	flyerService, 
	videoService, 
	websitePreviewService 
} from '@/lib/api';

const results = await Promise.allSettled([
  flyerService.listAll(),
  videoService.listAll(),
  websitePreviewService.listAll()
]);

const [flyerResult, videoResult, previewResult] = results;
const flyers = flyerResult.status === 'fulfilled' ? flyerResult.value : [];
const videos = videoResult.status === 'fulfilled' ? videoResult.value : [];
const previews = previewResult.status === 'fulfilled' ? previewResult.value : [];
const flyerModalData = JSON.stringify(flyers);
console.log(flyers, videos, previews);
---

<Layout>
	<div class="relative lg:justify-center bg-black lg:p-8 w-screen overflow-hidden">
		<div class="z-0 absolute inset-0 opacity-100 w-full h-full pointer-events-none">
			<SplashCursor
				SIM_RESOLUTION={128}
				DYE_RESOLUTION={1440}
				DENSITY_DISSIPATION={3.5}
				VELOCITY_DISSIPATION={2}
				PRESSURE={0.1}
				CURL={3}
				SPLAT_RADIUS={0.2}
				SPLAT_FORCE={6000}
				COLOR_UPDATE_SPEED={10}
				client:load
			/>
		</div>
		<header class="flex justify-between items-center h-16">
			<a href="/">
				<img src={nelfLogo.src} alt="Nelf Logo" class="w-30 h-15" />
			</a>

			<nav class="space-x-4 text-white">
				<a href="#craft" class="hover:text-nelf-pink">Our craft</a>
				<a href="#vision" class="hover:text-nelf-pink">Looking forward</a>
				<a href="#gallery" class="hover:text-nelf-pink">The gallery</a>
				<!--<a href="#team" class="hover:text-nelf-pink">Meet the creators</a>-->
			</nav>

			<nav class="text-white">
				<button class="hover:bg-white px-6 py-2.5 border border-white/70 rounded-md font-medium hover:text-gray-900 transition-all hover:-translate-y-0.5 duration-300 transform">
					Let's talk
				</button>
			</nav>
		</header>
		<main class="z-10 relative flex flex-col w-full transition-opacity duration-750 lg:grow">
			<section id="hero" class="relative flex justify-center items-center" style="height: calc(100vh - 7.1rem);">
				<div class="z-0 absolute inset-0 opacity-100 w-full h-full pointer-events-none">
					<LaserFlow
						color="#FF79C6"
						wispDensity={1}
						flowSpeed={0.35}
						verticalSizing={2}
						horizontalSizing={0.5}
						fogIntensity={0.45}
						fogScale={0.3}
						wispSpeed={15}
						wispIntensity={5}
						flowStrength={0.25}
						decay={1.1}
						horizontalBeamOffset={0}
						verticalBeamOffset={-0.5}
						client:load
					/>
				</div>
				<div class="z-10 relative flex flex-col items-center">
					<div class="flex items-center space-x-3 bg-white/10 shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur-md px-4 py-2 border border-white/20 rounded-full w-fit">
						<span onclick="window.location.href = '/admin/login';" class="inline-block bg-white hover:bg-nelf-pink shadow-[0_0_5px_rgba(255,255,255,0.8)] rounded-full w-1.5 h-1.5 cursor-pointer"></span>
						<p class="font-light text-white/80 text-xs uppercase tracking-widest">Votre troisieme main</p>
					</div>
					<div class="mt-4"></div>
					<h1 class="text-white text-8xl text-center">Build a personal brand <br/> That opens doors</h1>
					<div class="mt-8"></div>
					<p class="font-light text-[#555555] text-xl text-center">Create professional products that showcases your business brand, <br/> your vision, and helps you capture real growth</p>
					<div class="space-x-4 mt-12">
						<button class="bg-white px-6 py-2.5 border border-white/70 rounded-full font-medium hover:text-gray-900 transition-all hover:-translate-y-0.5 duration-300 transform">
							Start Creating
						</button>
						<button class="bg-[#333333] px-6 py-2.5 border border-white/70 rounded-full font-medium text-white transition-all hover:-translate-y-0.5 duration-300 transform">
							Browse Creations
						</button>
					</div>
					<!--<div class="mt-12"></div>
					<LogoLoop
						logos={techLogos}
						speed={100}
						direction="left"
						logoHeight={60}
						gap={60}
						hoverSpeed={0}
						scaleOnHover
						fadeOut
						fadeOutColor="#ffffff"
						ariaLabel="Technology partners"
					/>-->
				</div>
			</section>
			<section id="craft" class="flex justify-center items-center" style="height: calc(100vh - 4rem);">
				<div class="flex flex-col justify-center items-center">
					<h1 class="font-bold text-white text-6xl">Our craft</h1>
					<div class="mt-4"></div>
					<p class="font-light text-[#555555] text-xl text-center">Full-spectrum expertise, engineering your boldest visions into precise reality.</p>
					<div class="mt-8"></div>
					<div class="relative mx-auto mt-12 max-w-6xl">
						<div class="absolute inset-0 bg-linear-to-r from-pink-500/20 via-purple-500/20 to-blue-500/20 blur-3xl"></div>
						<div class="relative gap-8 grid grid-cols-1 md:grid-cols-3">
							{[
								{"id": "dev", "title": "Web & Mobile Development", "text": "Robust architectures and seamless interfaces. We engineer high-performance digital ecosystems from landing pages and e-commerce to complex web apps—built to scale", "icon": "code", "gradient": "from-cyan-400 to-blue-600", "position": "md:translate-y-4"},
								{"id": "design", "title": "Design & Branding", "text": "Visual identities that leave a lasting impression. From the foundational logo to comprehensive brand guidelines, we forge the visual soul of your business.", "icon": "palette", "gradient": "from-pink-400 to-purple-600", "position": "md:translate-y-0"}, 
								{"id": "motion", "title": "Motion & Content", "text": "Bring your message to life. We craft dynamic animations, promotional videos, and strategic content designed to capture instant attention and drive engagement.", "icon": "video", "gradient": "from-orange-400 to-red-600", "position": "md:translate-y-4"}
							].map((service, index) => (
								<div class={`group relative ${index % 2 === 0 ? 'translate-y-24' : '-translate-y-4'}`} data-service={service.id}>
									<div class="absolute -inset-1 bg-linear-to-r {service.gradient} rounded-lg blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
									<div class="relative bg-black/40 backdrop-blur-xl p-8 border border-white/10 hover:border-white/20 rounded-lg w-full h-96 hover:scale-105 transition-all duration-300 cursor-pointer hover:transform service-card">
										<div class="mb-4">
											{service.icon === 'code' && (
												<svg class="w-12 h-12 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
												</svg>
											)}
											{service.icon === 'palette' && (
												<svg class="w-12 h-12 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
												</svg>
											)}
											{service.icon === 'video' && (
												<svg class="w-12 h-12 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
												</svg>
											)}
										</div>
										<h3 class="text-2xl font-bold text-white mb-4 bg-linear-to-r {service.gradient} bg-clip-text text-transparent">{service.title}</h3>
										<p class="text-gray-300 leading-relaxed">{service.text}</p>
										<div class="flex items-center space-x-2 mt-6 text-white/60 group-hover:text-white transition-colors duration-300">
											<span class="text-sm">Explore</span>
											<svg class="w-4 h-4 transition-transform group-hover:translate-x-1 duration-300 transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
											</svg>
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>
			<section id="vision" class="flex justify-center items-center" style="height: calc(100vh - 4rem);">
				<div class="flex flex-col justify-center items-center">
					<div class="flex justify-center items-center">
						<p class="text-white text-4xl text-center">Innovating for a connected world that feels profoundly</p>
						<RotatingText
							client:load
							texts={['human', 'authentic', 'effortless', 'yours']}
							mainClassName="px-2 sm:px-2 md:px-3 bg-cyan-300 text-black text-4xl overflow-hidden py-0.5 sm:py-1 md:py-2 justify-center rounded-lg mx-2"
							staggerFrom={"last"}
							initial={{ y: "100%" }}
							animate={{ y: 0 }}
							exit={{ y: "-120%" }}
							staggerDuration={0.025}
							splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1 md:pb-1"
							transition={{ type: "spring", damping: 30, stiffness: 400 }}
							rotationInterval={2000}
						/>
					</div>
					<div class="mt-8"></div>
					<p class="text-white text-xl text-center">At NELF, we believe the best technology fades into the background, letting the experience take center stage. <br/>  Our mission is to simplify digital interactions and create genuinely authentic value.</p>
				</div>
			</section>
			<section
				id="gallery"
				class="flex flex-col items-center gap-12 py-24 px-6"
				style="min-height: calc(100vh - 4rem);"
			>
				<!-- Heading -->
				<div class="text-center">
					<h2 class="font-bold text-white text-6xl drop-shadow-2xl tracking-tight">
					Our creations
					</h2>
					<p class="mt-3 text-white/40 md:text-lg tracking-widest uppercase text-sm">
					A glimpse into our work
					</p>
				</div>

				<!-- Grid -->
				<div
					id="flyers"
					class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 w-full"
				>
					{
						flyers.map((flyer, index) => (
							<button
								type="button"
								class="group relative aspect-3/4 rounded-2xl overflow-hidden bg-gray-800 shadow-lg shadow-black/40 transition-all duration-500 hover:-translate-y-2 hover:shadow-nelf-pink/20 hover:shadow-2xl hover:ring-1 hover:ring-nelf-pink flyer-card"
								data-flyer-index={index}
								aria-label={`Open flyer ${flyer.name}`}
							>
								<!-- Image -->
								<img
									src={flyer.url}
									alt={flyer.name}
									class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 grayscale group-hover:scale-105 group-hover:grayscale-0"
								/>

								<div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent opacity-70 transition-opacity duration-500 group-hover:opacity-100"></div>
								<div class="right-0 bottom-0 left-0 absolute p-4 text-left">
									<p class="text-white/70 text-[0.65rem] uppercase tracking-[0.3em]">
										Flyer
									</p>
									<p class="mt-2 font-medium text-white text-sm md:text-base truncate">
										{flyer.name}
									</p>
								</div>
							</button>
						))
					}
				</div>

				<!-- Grid -->
				<div
					id="website-previews"
					class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 w-full"
				>
					{
						previews.map((preview, index) => (
							<button>
								<iframe src={preview.url} frameborder="0"></iframe>
							</button>
						))
					}
				</div>

			</section>
			<!--<section id="team" class="flex justify-center items-center" style="height: calc(100vh - 4rem);"></section>-->
		</main>
		<div
			id="flyer-modal"
			data-flyers={flyerModalData}
			class="hidden fixed inset-0 z-50 items-center justify-center p-4 sm:p-6"
			role="presentation"
			aria-hidden="true"
		>
			<button
				id="flyer-modal-backdrop"
				type="button"
				class="absolute inset-0 bg-black/85 backdrop-blur-md"
				aria-label="Close flyer modal"
			></button>

			<div
				class="relative z-10 grid max-h-[90vh] w-full max-w-6xl overflow-hidden rounded-[2rem] border border-white/10 bg-black/85 shadow-2xl shadow-black/70 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)]"
				role="dialog"
				aria-modal="true"
				aria-labelledby="flyer-modal-title"
			>
				<div class="relative flex min-h-80 items-center justify-center overflow-hidden bg-neutral-950 p-4 sm:p-6 lg:p-8">
					<img
						id="flyer-modal-image"
						src=""
						alt=""
						class="max-h-[72vh] w-full rounded-[1.5rem] object-contain"
					/>

					<button
						id="flyer-modal-prev"
						type="button"
						class="top-1/2 left-4 absolute flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/55 text-white transition hover:border-nelf-pink/60 hover:bg-black/75 disabled:cursor-not-allowed disabled:opacity-30"
						aria-label="Previous flyer"
					>
						<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 19l-7-7 7-7"></path>
						</svg>
					</button>

					<button
						id="flyer-modal-next"
						type="button"
						class="top-1/2 right-4 absolute flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-black/55 text-white transition hover:border-nelf-pink/60 hover:bg-black/75 disabled:cursor-not-allowed disabled:opacity-30"
						aria-label="Next flyer"
					>
						<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5l7 7-7 7"></path>
						</svg>
					</button>
				</div>

				<div class="flex flex-col overflow-y-auto border-white/10 border-t lg:border-t-0 lg:border-l">
					<div class="flex items-start justify-between gap-4 border-white/10 border-b px-6 py-5 sm:px-8">
						<div>
							<p id="flyer-modal-count" class="text-white/45 text-xs uppercase tracking-[0.35em]"></p>
							<h3 id="flyer-modal-title" class="mt-3 font-semibold text-white text-2xl sm:text-3xl"></h3>
						</div>
						<button
							id="flyer-modal-close"
							type="button"
							class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:border-white/30 hover:bg-white/10"
							aria-label="Close flyer modal"
						>
							<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>

					<div class="flex-1 space-y-6 px-6 py-6 sm:px-8 sm:py-8">
						<div id="flyer-modal-event-group" class="rounded-2xl border border-white/10 bg-white/5 p-4" hidden>
							<p class="text-white/45 text-[0.65rem] uppercase tracking-[0.3em]">Event</p>
							<p id="flyer-modal-event" class="mt-2 text-white text-lg"></p>
						</div>

						<div id="flyer-modal-short-info-group" hidden>
							<p class="text-white/45 text-[0.65rem] uppercase tracking-[0.3em]">Short info</p>
							<p id="flyer-modal-short-info" class="mt-3 text-white/80 leading-relaxed"></p>
						</div>

						<div id="flyer-modal-description-group" hidden>
							<p class="text-white/45 text-[0.65rem] uppercase tracking-[0.3em]">Description</p>
							<p id="flyer-modal-description" class="mt-3 text-white/75 leading-relaxed"></p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<footer class="z-10 relative bg-black/80 backdrop-blur-xl border-white/10 border-t">
			<div class="mx-auto px-8 py-16 max-w-7xl">
				<div class="gap-8 grid grid-cols-1 md:grid-cols-4">
					<!-- Brand Section -->
					<div class="col-span-1 md:col-span-2">
						<div class="flex items-center space-x-3 mb-6">
							<img src={nelfLogo.src} alt="Nelf Logo" class="w-12 h-8" />
							<span class="font-bold text-white text-xl">NELF</span>
						</div>
						<p class="mb-6 max-w-md text-gray-400 leading-relaxed">
							Your third hand in digital innovation. We craft exceptional experiences that bridge the gap between vision and reality.
						</p>
						<div class="flex space-x-4">
							<a href="#" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
								</svg>
							</a>
							<a href="#" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
								</svg>
							</a>
							<a href="#" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
								</svg>
							</a>
							<a href="#" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
								</svg>
							</a>
						</div>
					</div>

					<!-- Quick Links -->
					<div>
						<h3 class="mb-4 font-semibold text-white">Quick Links</h3>
