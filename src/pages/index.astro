---
import '../styles/global.css';
import Layout from '@/layouts/Layout.astro';
import nelfLogo from '@/assets/nelf-logo.jpeg';
import LaserFlow from '@/components/LaserFlow';
import SplashCursor from '@/components/SplashCursor';
import ServiceSidebar from '@/components/ServiceSidebar';
import RotatingText from '@/components/RotatingText';
import GridMotion from '@/components/GridMotion';

---

<Layout>
	<div class="relative lg:justify-center bg-black lg:p-8 w-screen overflow-hidden">
		<div class="z-0 absolute inset-0 opacity-100 w-full h-full pointer-events-none">
			<SplashCursor
				SIM_RESOLUTION={128}
				DYE_RESOLUTION={1440}
				DENSITY_DISSIPATION={3.5}
				VELOCITY_DISSIPATION={2}
				PRESSURE={0.1}
				CURL={3}
				SPLAT_RADIUS={0.2}
				SPLAT_FORCE={6000}
				COLOR_UPDATE_SPEED={10}
				client:load
			/>
		</div>
		<header class="flex justify-between items-center h-16">
			<a href="/">
				<img src={nelfLogo.src} alt="Nelf Logo" class="w-30 h-15" />
			</a>

			<nav class="space-x-4 text-white">
				<a href="#craft" class="hover:text-nelf-pink">Our craft</a>
				<a href="#vision" class="hover:text-nelf-pink">Looking forward</a>
				<a href="#gallery" class="hover:text-nelf-pink">The gallery</a>
				<a href="#team" class="hover:text-nelf-pink">Meet the creators</a>
			</nav>

			<nav class="text-white">
				<button class="hover:bg-white px-6 py-2.5 border border-white/70 rounded-md font-medium hover:text-gray-900 transition-all hover:-translate-y-0.5 duration-300 transform">
					Let's talk
				</button>
			</nav>
		</header>
		<main class="z-10 relative flex flex-col w-full transition-opacity duration-750 lg:grow">
			<section id="hero" class="relative flex justify-center items-center" style="height: calc(100vh - 7.1rem);">
				<div class="z-0 absolute inset-0 opacity-100 w-full h-full pointer-events-none">
					<LaserFlow
						color="#FF79C6"
						wispDensity={1}
						flowSpeed={0.35}
						verticalSizing={2}
						horizontalSizing={0.5}
						fogIntensity={0.45}
						fogScale={0.3}
						wispSpeed={15}
						wispIntensity={5}
						flowStrength={0.25}
						decay={1.1}
						horizontalBeamOffset={0}
						verticalBeamOffset={-0.5}
						client:load
					/>
				</div>
				<div class="z-10 relative flex flex-col items-center">
					<div class="flex items-center space-x-3 bg-white/10 shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur-md px-4 py-2 border border-white/20 rounded-full w-fit">
						<span class="inline-block bg-white shadow-[0_0_5px_rgba(255,255,255,0.8)] rounded-full w-1.5 h-1.5"></span>
						<p class="font-light text-white/80 text-xs uppercase tracking-widest">Votre troisieme main</p>
					</div>
					<div class="mt-4"></div>
					<h1 class="text-white text-8xl text-center">Build a personal brand <br/> That opens doors</h1>
					<div class="mt-8"></div>
					<p class="font-light text-[#555555] text-xl text-center">Create professional products that showcases your business brand, <br/> your vision, and helps you capture real growth</p>
					<div class="space-x-4 mt-12">
						<button class="bg-white px-6 py-2.5 border border-white/70 rounded-full font-medium hover:text-gray-900 transition-all hover:-translate-y-0.5 duration-300 transform">
							Start Creating
						</button>
						<button class="bg-[#333333] px-6 py-2.5 border border-white/70 rounded-full font-medium text-white transition-all hover:-translate-y-0.5 duration-300 transform">
							Browse Creations
						</button>
					</div>
					<!--<div class="mt-12"></div>
					<LogoLoop
						logos={techLogos}
						speed={100}
						direction="left"
						logoHeight={60}
						gap={60}
						hoverSpeed={0}
						scaleOnHover
						fadeOut
						fadeOutColor="#ffffff"
						ariaLabel="Technology partners"
					/>-->
				</div>
			</section>
			<section id="craft" class="flex justify-center items-center" style="height: calc(100vh - 4rem);">
				<div class="flex flex-col justify-center items-center">
					<h1 class="font-bold text-white text-6xl">Our craft</h1>
					<div class="mt-4"></div>
					<p class="font-light text-[#555555] text-xl text-center">Full-spectrum expertise, engineering your boldest visions into precise reality.</p>
					<div class="mt-8"></div>
					<div class="relative mx-auto mt-12 max-w-6xl">
						<div class="absolute inset-0 bg-linear-to-r from-pink-500/20 via-purple-500/20 to-blue-500/20 blur-3xl"></div>
						<div class="relative gap-8 grid grid-cols-1 md:grid-cols-3">
							{[
								{"id": "dev", "title": "Web & Mobile Development", "text": "Robust architectures and seamless interfaces. We engineer high-performance digital ecosystems from landing pages and e-commerce to complex web apps—built to scale", "icon": "code", "gradient": "from-cyan-400 to-blue-600", "position": "md:translate-y-4"},
								{"id": "design", "title": "Design & Branding", "text": "Visual identities that leave a lasting impression. From the foundational logo to comprehensive brand guidelines, we forge the visual soul of your business.", "icon": "palette", "gradient": "from-pink-400 to-purple-600", "position": "md:translate-y-0"}, 
								{"id": "motion", "title": "Motion & Contenu", "text": "Bring your message to life. We craft dynamic animations, promotional videos, and strategic content designed to capture instant attention and drive engagement.", "icon": "video", "gradient": "from-orange-400 to-red-600", "position": "md:translate-y-4"}
							].map((service, index) => (
								<div class={`group relative ${index % 2 === 0 ? 'translate-y-24' : '-translate-y-4'}`} data-service={service.id}>
									<div class="absolute -inset-1 bg-linear-to-r {service.gradient} rounded-lg blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
									<div class="relative bg-black/40 backdrop-blur-xl p-8 border border-white/10 hover:border-white/20 rounded-lg w-full h-96 hover:scale-105 transition-all duration-300 cursor-pointer hover:transform service-card">
										<div class="mb-4">
											{service.icon === 'code' && (
												<svg class="w-12 h-12 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
												</svg>
											)}
											{service.icon === 'palette' && (
												<svg class="w-12 h-12 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
												</svg>
											)}
											{service.icon === 'video' && (
												<svg class="w-12 h-12 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
												</svg>
											)}
										</div>
										<h3 class="text-2xl font-bold text-white mb-4 bg-linear-to-r {service.gradient} bg-clip-text text-transparent">{service.title}</h3>
										<p class="text-gray-300 leading-relaxed">{service.text}</p>
										<div class="flex items-center space-x-2 mt-6 text-white/60 group-hover:text-white transition-colors duration-300">
											<span class="text-sm">Explore</span>
											<svg class="w-4 h-4 transition-transform group-hover:translate-x-1 duration-300 transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
											</svg>
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>
			<section id="vision" class="flex justify-center items-center" style="height: calc(100vh - 4rem);">
				<div class="flex flex-col justify-center items-center">
					<div class="flex justify-center items-center">
						<p class="text-white text-4xl text-center">Innovating for a connected world that feels profoundly</p>
						<RotatingText
							client:load
							texts={['human', 'authentic', 'effortless', 'yours']}
							mainClassName="px-2 sm:px-2 md:px-3 bg-cyan-300 text-black text-4xl overflow-hidden py-0.5 sm:py-1 md:py-2 justify-center rounded-lg mx-2"
							staggerFrom={"last"}
							initial={{ y: "100%" }}
							animate={{ y: 0 }}
							exit={{ y: "-120%" }}
							staggerDuration={0.025}
							splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1 md:pb-1"
							transition={{ type: "spring", damping: 30, stiffness: 400 }}
							rotationInterval={2000}
						/>
					</div>
					<div class="mt-8"></div>
					<p class="text-white text-xl text-center">At NELF, we believe the best technology fades into the background, letting the experience take center stage. <br/>  Our mission is to simplify digital interactions and create genuinely authentic value.</p>
				</div>
			</section>
			<section id="gallery" class="relative flex justify-center items-center" style="height: calc(100vh - 4rem);">
				<div class="z-0 absolute inset-0">
					<GridMotion
						client:load
						scrollEnabled={true}
						items={[
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src,
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src,
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src,
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src,
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src,
							nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src, nelfLogo.src
						]}
						gradientColor="#5227FF"
						onItemClick={(index, item) => {
							console.log('Clicked grid item:', index, item);
							// You can add modal or detail view logic here
						}}
					/>
				</div>
				<div class="z-10 relative flex flex-col justify-center items-center">
					<h1 class="font-bold text-white text-6xl">Our creations</h1>
				</div>
			</section>
			<section id="team" class="flex justify-center items-center" style="height: calc(100vh - 4rem);"></section>
		</main>
	</div>
</Layout>

<ServiceSidebar client:load />

<script>
	// Card click handlers
	document.querySelectorAll('.service-card').forEach(card => {
		card.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const serviceElement = target.closest('[data-service]');
			if (serviceElement) {
				const serviceId = (serviceElement as HTMLElement).dataset.service;
				if (serviceId) {
					// Dispatch custom event to open sidebar
					document.dispatchEvent(new CustomEvent('openServiceSidebar', {
						detail: { serviceId }
					}));
				}
			}
		});
	});
</script>

