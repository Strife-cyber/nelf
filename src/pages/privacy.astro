---
import '../styles/global.css';
import Layout from '@/layouts/Layout.astro';
import nelfLogo from '@/assets/nelf-logo.jpeg';
---

<Layout title="Privacy Policy - NELF">
	<div class="bg-black min-h-screen text-white">
		<!-- Header -->
		<header class="z-10 relative bg-black/80 backdrop-blur-xl border-white/10 border-b">
			<div class="mx-auto px-8 py-6 max-w-7xl">
				<div class="flex justify-between items-center">
					<a href="/" class="flex items-center space-x-3">
						<img src={nelfLogo.src} alt="Nelf Logo" class="w-10 h-8" />
						<span class="font-bold text-white text-xl">NELF</span>
					</a>
					<nav class="text-white">
						<a href="/" class="hover:text-nelf-pink transition-colors duration-300">← Back to Home</a>
					</nav>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="z-10 relative mx-auto px-8 py-16 max-w-4xl">
			<div class="space-y-12">
				<!-- Title Section -->
				<div class="space-y-4 text-center">
					<h1 class="bg-clip-text bg-linear-to-r from-cyan-400 to-pink-600 font-bold text-transparent text-5xl md:text-6xl">
						Privacy Policy
					</h1>
					<p class="mx-auto max-w-2xl text-gray-400 text-lg">
						Your privacy is fundamental to our relationship. This policy outlines how we collect, use, and protect your information.
					</p>
					<div class="text-gray-500 text-sm">
						Last updated: March 28, 2026
					</div>
				</div>

				<!-- Content Sections -->
				<div class="space-y-8">
					<!-- Introduction -->
					<section class="bg-white/5 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="flex items-center mb-4 font-bold text-white text-2xl">
							<svg class="mr-3 w-6 h-6 text-nelf-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Introduction
						</h2>
						<p class="text-gray-300 leading-relaxed">
							At NELF, we are committed to protecting your privacy and ensuring the security of your personal information. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website or use our services.
						</p>
					</section>

					<!-- Information We Collect -->
					<section class="bg-white/5 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="flex items-center mb-4 font-bold text-white text-2xl">
							<svg class="mr-3 w-6 h-6 text-nelf-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
							Information We Collect
						</h2>
						<div class="space-y-4 text-gray-300">
							<div>
								<h3 class="mb-2 font-semibold text-white">Personal Information</h3>
								<p>Name, email address, phone number, and other contact details you provide when reaching out to us or using our services.</p>
							</div>
							<div>
								<h3 class="mb-2 font-semibold text-white">Technical Information</h3>
								<p>IP address, browser type, device information, and usage data collected automatically through cookies and similar technologies.</p>
							</div>
							<div>
								<h3 class="mb-2 font-semibold text-white">Project Information</h3>
								<p>Details about your projects, requirements, and any materials you share with us for service delivery.</p>
							</div>
						</div>
					</section>

					<!-- How We Use Your Information -->
					<section class="bg-white/5 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="flex items-center mb-4 font-bold text-white text-2xl">
							<svg class="mr-3 w-6 h-6 text-nelf-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							</svg>
							How We Use Your Information
						</h2>
						<ul class="space-y-3 text-gray-300">
							<li class="flex items-start">
								<span class="mr-3 text-nelf-pink">•</span>
								<span>To provide and maintain our services</span>
							</li>
							<li class="flex items-start">
								<span class="mr-3 text-nelf-pink">•</span>
								<span>To communicate with you about your projects and inquiries</span>
							</li>
							<li class="flex items-start">
								<span class="mr-3 text-nelf-pink">•</span>
								<span>To improve our website and services</span>
							</li>
							<li class="flex items-start">
								<span class="mr-3 text-nelf-pink">•</span>
								<span>To send you marketing communications (with your consent)</span>
							</li>
							<li class="flex items-start">
								<span class="mr-3 text-nelf-pink">•</span>
								<span>To comply with legal obligations</span>
							</li>
						</ul>
					</section>

					<!-- Data Security -->
					<section class="bg-white/5 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="flex items-center mb-4 font-bold text-white text-2xl">
							<svg class="mr-3 w-6 h-6 text-nelf-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
							Data Security
						</h2>
						<p class="text-gray-300 leading-relaxed">
							We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. These include SSL encryption, secure servers, and regular security audits.
						</p>
					</section>

					<!-- Your Rights -->
					<section class="bg-white/5 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="flex items-center mb-4 font-bold text-white text-2xl">
							<svg class="mr-3 w-6 h-6 text-nelf-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
							Your Rights
						</h2>
						<div class="space-y-4 text-gray-300">
							<p>You have the right to:</p>
							<ul class="space-y-2 ml-4">
								<li>• Access your personal information</li>
								<li>• Correct inaccurate information</li>
								<li>• Request deletion of your information</li>
								<li>• Object to processing of your information</li>
								<li>• Request data portability</li>
							</ul>
						</div>
					</section>

					<!-- Contact Information -->
					<section class="bg-linear-to-r from-pink-500/10 to-purple-500/10 backdrop-blur-sm p-8 border border-white/10 rounded-xl">
						<h2 class="mb-4 font-bold text-white text-2xl">Contact Us</h2>
						<p class="mb-4 text-gray-300">
							If you have any questions about this Privacy Policy or how we handle your information, please contact us:
						</p>
						<div class="space-y-2 text-gray-300">
							<p><strong>Email:</strong> lotharnjock08@gmail.com</p>
							<p><strong>Response Time:</strong> We'll respond within 48 hours</p>
						</div>
					</section>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="z-10 relative bg-black/80 backdrop-blur-xl mt-16 border-white/10 border-t">
			<div class="mx-auto px-8 py-16 max-w-7xl">
				<div class="gap-8 grid grid-cols-1 md:grid-cols-4">
					<!-- Brand Section -->
					<div class="col-span-1 md:col-span-2">
						<div class="flex items-center space-x-3 mb-6">
							<img src={nelfLogo.src} alt="Nelf Logo" class="w-12 h-8" />
							<span class="font-bold text-white text-xl">NELF</span>
						</div>
						<p class="mb-6 max-w-md text-gray-400 leading-relaxed">
							Your third hand in digital innovation. We craft exceptional experiences that bridge the gap between vision and reality.
						</p>
						<div class="flex space-x-4">
							<a href="https://wa.me/237658835899" target="_blank" rel="noopener noreferrer" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300" aria-label="WhatsApp">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M20.52 3.48A11.85 11.85 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.15 1.59 5.97L0 24l6.3-1.65a11.92 11.92 0 0 0 5.78 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.5-8.4Zm-8.44 18.32h-.01a9.92 9.92 0 0 1-5.05-1.38l-.36-.21-3.74.98 1-3.64-.23-.37a9.92 9.92 0 0 1-1.52-5.25c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.03 2.92a9.87 9.87 0 0 1 2.92 7.04c0 5.49-4.47 9.96-9.97 9.96Zm5.46-7.46c-.3-.15-1.76-.87-2.03-.97-.27-.1-.46-.15-.66.15-.2.3-.76.97-.94 1.17-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.46-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.38-.02-.52-.08-.15-.66-1.59-.9-2.18-.24-.57-.48-.49-.66-.5h-.56c-.2 0-.52.08-.79.38-.27.3-1.04 1.02-1.04 2.49s1.06 2.9 1.21 3.1c.15.2 2.08 3.18 5.04 4.45.71.31 1.27.5 1.7.64.71.23 1.35.2 1.86.12.57-.08 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z"></path>
								</svg>
							</a>
							<a href="mailto:lotharnjock08@gmail.com" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300" aria-label="Email">
								<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7.5 12 13l9-5.5"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5.5h14A2.5 2.5 0 0 1 21.5 8v8A2.5 2.5 0 0 1 19 18.5H5A2.5 2.5 0 0 1 2.5 16V8A2.5 2.5 0 0 1 5 5.5Z"></path>
								</svg>
							</a>
							<a href="https://www.facebook.com/profile.php?id=61587001344562" target="_blank" rel="noopener noreferrer" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300" aria-label="Facebook">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
								</svg>
							</a>
							<a href="https://www.instagram.com/nelf_vtm/" target="_blank" rel="noopener noreferrer" class="flex justify-center items-center bg-white/10 hover:bg-nelf-pink/20 border border-white/20 hover:border-nelf-pink/40 rounded-full w-10 h-10 hover:scale-110 transition-all duration-300" aria-label="Instagram">
								<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
								</svg>
							</a>
						</div>
					</div>

					<!-- Quick Links -->
					<div>
						<h3 class="mb-4 font-semibold text-white">Quick Links</h3>
						<ul class="space-y-3">
							<li><a href="/#craft" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Our Craft</a></li>
							<li><a href="/#vision" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Vision</a></li>
							<li><a href="/#gallery" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Gallery</a></li>
						</ul>
					</div>

					<!-- Services -->
					<div>
						<h3 class="mb-4 font-semibold text-white">Services</h3>
						<ul class="space-y-3">
							<li><a href="/#" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Web Development</a></li>
							<li><a href="/#" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Mobile Apps</a></li>
							<li><a href="/#" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Design & Branding</a></li>
							<li><a href="/#" class="text-gray-400 hover:text-nelf-pink transition-colors duration-300">Motion & Content</a></li>
						</ul>
					</div>
				</div>

				<!-- Bottom Bar -->
				<div class="flex md:flex-row flex-col justify-between items-center mt-12 pt-8 border-white/10 border-t">
					<p class="mb-4 md:mb-0 text-gray-400 text-sm">
						© 2026 NELF. All rights reserved.
					</p>
					<div class="flex space-x-6">
						<a href="/privacy" class="text-nelf-pink text-sm">Privacy Policy</a>
						<a href="/terms" class="text-gray-400 hover:text-nelf-pink text-sm transition-colors duration-300">Terms of Service</a>
						<a href="mailto:lotharnjock08@gmail.com" class="text-gray-400 hover:text-nelf-pink text-sm transition-colors duration-300">Contact</a>
					</div>
				</div>
			</div>
		</footer>
	</div>
</Layout>
