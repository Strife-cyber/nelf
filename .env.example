# Base URL for the Nelf backend API (must include /api)
# Example: http://localhost:3000/api
PUBLIC_API_BASE_URL=http://localhost:3000/api

# Public host for the frontend container
TRAEFIK_HOST=nelf.strife-cyber.org

# Common Traefik defaults. Change these if your proxy uses different names.
TRAEFIK_ENTRYPOINTS=https
TRAEFIK_CERTRESOLVER=letsencrypt
