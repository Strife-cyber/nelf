<ServiceSidebar client:load />

<script>
	// Card click handlers
	document.querySelectorAll('.service-card').forEach(card => {
		card.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const serviceElement = target.closest('[data-service]');
			if (serviceElement) {
				const serviceId = (serviceElement as HTMLElement).dataset.service;
				if (serviceId) {
					// Dispatch custom event to open sidebar
					document.dispatchEvent(new CustomEvent('openServiceSidebar', {
						detail: { serviceId }
					}));
				}
			}
		});
	});

	type FlyerModalItem = {
		name?: string;
		description?: string;
		event_title?: string;
		short_info?: string;
		url: string;
	};

	const flyerModal = document.getElementById('flyer-modal');
	const flyerModalClose = document.getElementById('flyer-modal-close');
	const flyerModalBackdrop = document.getElementById('flyer-modal-backdrop');
	const flyerModalPrev = document.getElementById('flyer-modal-prev') as HTMLButtonElement | null;
	const flyerModalNext = document.getElementById('flyer-modal-next') as HTMLButtonElement | null;
	const flyerModalImage = document.getElementById('flyer-modal-image') as HTMLImageElement | null;
	const flyerModalCount = document.getElementById('flyer-modal-count');
	const flyerModalTitle = document.getElementById('flyer-modal-title');
	const flyerModalEventGroup = document.getElementById('flyer-modal-event-group');
	const flyerModalEvent = document.getElementById('flyer-modal-event');
	const flyerModalShortInfoGroup = document.getElementById('flyer-modal-short-info-group');
	const flyerModalShortInfo = document.getElementById('flyer-modal-short-info');
	const flyerModalDescriptionGroup = document.getElementById('flyer-modal-description-group');
	const flyerModalDescription = document.getElementById('flyer-modal-description');
	const flyerCards = document.querySelectorAll('[data-flyer-index]');
	const flyerItems = flyerModal ? JSON.parse(flyerModal.dataset.flyers || '[]') as FlyerModalItem[] : [];

	let activeFlyerIndex = 0;
	let flyerModalOpen = false;
	let previousBodyOverflow = '';
	let lastFlyerTrigger: HTMLElement | null = null;

	const setOptionalContent = (
		group: HTMLElement | null,
		element: HTMLElement | null,
		value?: string
	) => {
		if (!group || !element) return;

		const content = value?.trim();
		if (!content) {
			group.hidden = true;
			element.textContent = '';
			return;
		}

		group.hidden = false;
		element.textContent = content;
	};

	const updateFlyerModal = (index: number) => {
		if (!flyerModalImage || !flyerModalTitle || flyerItems.length === 0) return;

		const flyer = flyerItems[index];
		if (!flyer) return;

		activeFlyerIndex = index;
		flyerModalImage.src = flyer.url;
		flyerModalImage.alt = flyer.name ? `${flyer.name} flyer` : 'Flyer';
		flyerModalTitle.textContent = flyer.name?.trim() || 'Untitled flyer';

		if (flyerModalCount) {
			flyerModalCount.textContent = `${String(index + 1).padStart(2, '0')} / ${String(flyerItems.length).padStart(2, '0')}`;
		}

		setOptionalContent(flyerModalEventGroup, flyerModalEvent, flyer.event_title);
		setOptionalContent(flyerModalShortInfoGroup, flyerModalShortInfo, flyer.short_info);
		setOptionalContent(flyerModalDescriptionGroup, flyerModalDescription, flyer.description);

		flyerModalPrev?.toggleAttribute('disabled', index === 0);
		flyerModalNext?.toggleAttribute('disabled', index === flyerItems.length - 1);
	};

	const openFlyerModal = (index: number, trigger?: HTMLElement | null) => {
		if (!flyerModal || flyerItems.length === 0) return;

		updateFlyerModal(index);
		previousBodyOverflow = document.body.style.overflow;
		document.body.style.overflow = 'hidden';
		flyerModal.classList.remove('hidden');
		flyerModal.classList.add('flex');
		flyerModal.setAttribute('aria-hidden', 'false');
		flyerModalOpen = true;
		lastFlyerTrigger = trigger || null;
		flyerModalClose?.focus();
	};

	const closeFlyerModal = () => {
		if (!flyerModal || !flyerModalOpen) return;

		flyerModal.classList.add('hidden');
		flyerModal.classList.remove('flex');
		flyerModal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = previousBodyOverflow;
		flyerModalOpen = false;
		lastFlyerTrigger?.focus();
	};

	const moveFlyerModal = (direction: number) => {
		const nextIndex = activeFlyerIndex + direction;
		if (nextIndex < 0 || nextIndex >= flyerItems.length) return;
		updateFlyerModal(nextIndex);
	};

	flyerCards.forEach(card => {
		card.addEventListener('click', () => {
			const target = card as HTMLElement;
			const index = Number(target.dataset.flyerIndex);
			if (Number.isNaN(index)) return;
			openFlyerModal(index, target);
		});
	});

	flyerModalClose?.addEventListener('click', closeFlyerModal);
	flyerModalBackdrop?.addEventListener('click', closeFlyerModal);
	flyerModalPrev?.addEventListener('click', () => moveFlyerModal(-1));
	flyerModalNext?.addEventListener('click', () => moveFlyerModal(1));

	document.addEventListener('keydown', (event) => {
		if (!flyerModalOpen) return;

		if (event.key === 'Escape') {
			closeFlyerModal();
			return;
		}

		if (event.key === 'ArrowLeft') {
			event.preventDefault();
			moveFlyerModal(-1);
		}

		if (event.key === 'ArrowRight') {
			event.preventDefault();
			moveFlyerModal(1);
		}
	});
</script>
