---
export interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
}

const { 
	title = 'NELF - Votre troisième main',
	description = 'Votre troisième main dans l\'innovation numérique. Nous créons des expériences exceptionnelles qui comblent l\'écart entre vision et réalité.',
	image = '/favicon.svg', // Ideally a dedicated OG image, but favicon is better than nothing for now
	canonicalURL = Astro.url.href
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<!-- Global Metadata -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Accessibility and Theme -->
		<meta name="theme-color" content="#000000" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
