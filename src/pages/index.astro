				'Websites, branding, campaigns, product launches, and end-to-end creative support.',
				'Bring your goal, rough timeline, references, and anything that should not be missed.',
				'Outcome: a polished project brief you can paste into email, WhatsApp, or your favorite channel.',
			],
		},
		contact: {
			eyebrow: 'Contact',
			title: 'Ask a question, start a conversation, or follow up.',
			copy: "Use this when you have a general question, a partnership idea, a support request, or you simply want to reach out without writing a full project brief.",
			badge: 'General inquiries',
			highlights: [
				'Questions, partnerships, media requests, support, or if you are still figuring out the right service.',
				'Keep it short, direct, and conversational. No full brief needed here.',
				'Outcome: a simple contact note ready for email, DM, or WhatsApp.',
			],
		},
	};

	const setContactModalMode = (mode: ContactModalMode) => {
		if (!contactModal || !contactModalTitle || !contactModalEyebrow || !contactModalCopy || !contactModalHighlights) return;

		const content = contactContent[mode];
		contactModal.dataset.contactMode = mode;
		contactModalEyebrow.textContent = content.eyebrow;
		contactModalTitle.textContent = content.title;
		contactModalCopy.textContent = content.copy;

		contactModalHighlights.innerHTML = content.highlights
			.map((item) => `<div class="rounded-2xl border border-white/10 bg-black/30 p-4"><p class="leading-relaxed">${item}</p></div>`)
			.join('');

		contactPanelTalk?.classList.toggle('hidden', mode !== 'talk');
		contactPanelGeneral?.classList.toggle('hidden', mode !== 'contact');

		document.querySelectorAll<HTMLElement>('[data-contact-accent]').forEach((accent) => {
			accent.classList.toggle('hidden', accent.dataset.contactAccent !== mode);
		});

		if (mode === 'talk') {
			(document.getElementById('project-name') as HTMLInputElement | null)?.focus();
		} else {
			(document.getElementById('contact-name') as HTMLInputElement | null)?.focus();
		}
	};

	const openContactModal = (mode: ContactModalMode, trigger?: HTMLElement | null) => {
		if (!contactModal) return;

		lockBodyScroll();
		contactModal.classList.remove('hidden');
		contactModal.classList.add('flex');
		contactModal.setAttribute('aria-hidden', 'false');
		contactModalOpen = true;
		lastContactTrigger = trigger || null;
		setContactModalMode(mode);
	};

	const closeContactModal = () => {
		if (!contactModal || !contactModalOpen) return;

		contactModal.classList.add('hidden');
		contactModal.classList.remove('flex');
		contactModal.setAttribute('aria-hidden', 'true');
		unlockBodyScroll();
		contactModalOpen = false;
		lastContactTrigger?.focus();
	};

	const updateFlyerModal = (index: number) => {
		if (!flyerModalImage || !flyerModalTitle || flyerItems.length === 0) return;

		const flyer = flyerItems[index];
		if (!flyer) return;

		activeFlyerIndex = index;
		flyerModalImage.src = flyer.url;
		flyerModalImage.alt = flyer.name ? `${flyer.name} flyer` : 'Flyer';
		flyerModalTitle.textContent = flyer.name?.trim() || 'Untitled flyer';

		if (flyerModalCount) {
			flyerModalCount.textContent = `${String(index + 1).padStart(2, '0')} / ${String(flyerItems.length).padStart(2, '0')}`;
		}

		setOptionalContent(flyerModalEventGroup, flyerModalEvent, flyer.event_title);
		setOptionalContent(flyerModalShortInfoGroup, flyerModalShortInfo, flyer.short_info);
		setOptionalContent(flyerModalDescriptionGroup, flyerModalDescription, flyer.description);

		flyerModalPrev?.toggleAttribute('disabled', index === 0);
		flyerModalNext?.toggleAttribute('disabled', index === flyerItems.length - 1);
	};

	const openFlyerModal = (index: number, trigger?: HTMLElement | null) => {
		if (!flyerModal || flyerItems.length === 0) return;

		updateFlyerModal(index);
		lockBodyScroll();
		flyerModal.classList.remove('hidden');
		flyerModal.classList.add('flex');
		flyerModal.setAttribute('aria-hidden', 'false');
		flyerModalOpen = true;
		lastFlyerTrigger = trigger || null;
		flyerModalClose?.focus();
	};

	const closeFlyerModal = () => {
		if (!flyerModal || !flyerModalOpen) return;

		flyerModal.classList.add('hidden');
		flyerModal.classList.remove('flex');
		flyerModal.setAttribute('aria-hidden', 'true');
		unlockBodyScroll();
		flyerModalOpen = false;
		lastFlyerTrigger?.focus();
	};

	const moveFlyerModal = (direction: number) => {
		const nextIndex = activeFlyerIndex + direction;
		if (nextIndex < 0 || nextIndex >= flyerItems.length) return;
		updateFlyerModal(nextIndex);
	};

	const updateVideoModal = (index: number) => {
		if (!videoModalPlayer || !videoModalTitle || videoItems.length === 0) return;

		const video = videoItems[index];
		if (!video) return;

		activeVideoIndex = index;
		videoModalPlayer.pause();
		videoModalPlayer.src = video.url;
		videoModalPlayer.poster = video.thumbnail_url || '';
		videoModalPlayer.load();
		videoModalTitle.textContent = video.name?.trim() || 'Untitled video';

		if (videoModalCount) {
			videoModalCount.textContent = `${String(index + 1).padStart(2, '0')} / ${String(videoItems.length).padStart(2, '0')}`;
		}

		if (videoModalEventLabel) {
			videoModalEventLabel.textContent = video.event_title?.trim() || 'Video showcase';
		}

		setOptionalContent(videoModalEventGroup, videoModalEvent, video.event_title);
		setOptionalContent(videoModalShortInfoGroup, videoModalShortInfo, video.short_info);
		setOptionalContent(videoModalDescriptionGroup, videoModalDescription, video.description);

		videoModalPrev?.toggleAttribute('disabled', index === 0);
		videoModalNext?.toggleAttribute('disabled', index === videoItems.length - 1);
	};

	const openVideoModal = (index: number, trigger?: HTMLElement | null) => {
		if (!videoModal || videoItems.length === 0) return;

		updateVideoModal(index);
		lockBodyScroll();
		videoModal.classList.remove('hidden');
		videoModal.classList.add('flex');
		videoModal.setAttribute('aria-hidden', 'false');
		videoModalOpen = true;
		lastVideoTrigger = trigger || null;
		videoModalClose?.focus();
		videoModalPlayer?.play().catch(() => {});
	};

	const closeVideoModal = () => {
		if (!videoModal || !videoModalOpen) return;

		videoModal.classList.add('hidden');
		videoModal.classList.remove('flex');
		videoModal.setAttribute('aria-hidden', 'true');
		if (videoModalPlayer) {
			videoModalPlayer.pause();
			videoModalPlayer.removeAttribute('src');
			videoModalPlayer.load();
			videoModalPlayer.poster = '';
		}
		unlockBodyScroll();
		videoModalOpen = false;
		lastVideoTrigger?.focus();
	};

	const moveVideoModal = (direction: number) => {
		const nextIndex = activeVideoIndex + direction;
		if (nextIndex < 0 || nextIndex >= videoItems.length) return;
		updateVideoModal(nextIndex);
		videoModalPlayer?.play().catch(() => {});
	};

	const updateWebsiteModal = (index: number) => {
		if (
			!websiteModalFrame ||
			!websiteModalTitle ||
			!websiteModalHostname ||
			!websiteModalContentType ||
			!websiteModalUrl ||
			websiteItems.length === 0
		) return;

		const website = websiteItems[index];
		if (!website) return;

		websiteModalFrame.src = website.url;
		websiteModalFrame.title = website.title || website.hostname;
		websiteModalTitle.textContent = website.title?.trim() || website.hostname;
		websiteModalHostname.textContent = website.hostname;
		if (websiteModalBrowserHost) {
			websiteModalBrowserHost.textContent = website.url;
		}
		websiteModalContentType.textContent = website.content_type;
		websiteModalUrl.textContent = website.url;

		if (websiteModalLink) {
			websiteModalLink.href = website.url;
		}

		if (websiteModalFavicon) {
			const faviconUrl = website.favicon_url?.trim();
			if (faviconUrl) {
				websiteModalFavicon.src = faviconUrl;
				websiteModalFavicon.hidden = false;
				websiteModalFaviconFallback?.setAttribute('hidden', '');
			} else {
				websiteModalFavicon.src = '';
				websiteModalFavicon.hidden = true;
				websiteModalFaviconFallback?.removeAttribute('hidden');
			}
		}

		setOptionalContent(websiteModalShortInfoGroup, websiteModalShortInfo, website.short_info);
		setOptionalContent(websiteModalDescriptionGroup, websiteModalDescription, website.description);
	};

	const openWebsiteModal = (index: number, trigger?: HTMLElement | null) => {
		if (!websiteModal || websiteItems.length === 0) return;

		updateWebsiteModal(index);
		lockBodyScroll();
		websiteModal.classList.remove('hidden');
		websiteModal.classList.add('flex');
		websiteModal.setAttribute('aria-hidden', 'false');
		websiteModalOpen = true;
		lastWebsiteTrigger = trigger || null;
		websiteModalClose?.focus();
	};

	const closeWebsiteModal = () => {
		if (!websiteModal || !websiteModalOpen) return;

		websiteModal.classList.add('hidden');
		websiteModal.classList.remove('flex');
		websiteModal.setAttribute('aria-hidden', 'true');
		if (websiteModalFrame) {
			websiteModalFrame.src = '';
		}
		unlockBodyScroll();
		websiteModalOpen = false;
		lastWebsiteTrigger?.focus();
	};

	flyerCards.forEach(card => {
		card.addEventListener('click', () => {
			const target = card as HTMLElement;
			const index = Number(target.dataset.flyerIndex);
			if (Number.isNaN(index)) return;
			openFlyerModal(index, target);
		});
	});

	contactTriggers.forEach((trigger) => {
		const openWithMode = () => {
			const mode = (trigger.dataset.contactOpen === 'contact' ? 'contact' : 'talk') as ContactModalMode;
			openContactModal(mode, trigger);
		};

		trigger.addEventListener('click', openWithMode);
		trigger.addEventListener('keydown', (event: KeyboardEvent) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			openWithMode();
		});
	});

	document.getElementById('contact-modal-close')?.addEventListener('click', closeContactModal);
	document.querySelectorAll<HTMLElement>('.contact-modal-close').forEach((button) => {
		button.addEventListener('click', closeContactModal);
	});
	contactModalBackdrop?.addEventListener('click', closeContactModal);

	flyerModalClose?.addEventListener('click', closeFlyerModal);
	flyerModalBackdrop?.addEventListener('click', closeFlyerModal);
	flyerModalPrev?.addEventListener('click', () => moveFlyerModal(-1));
	flyerModalNext?.addEventListener('click', () => moveFlyerModal(1));

	videoCards.forEach(card => {
		card.addEventListener('click', () => {
			const target = card as HTMLElement;
			const index = Number(target.dataset.videoIndex);
			if (Number.isNaN(index)) return;
			openVideoModal(index, target);
		});
	});

	videoModalClose?.addEventListener('click', closeVideoModal);
	videoModalBackdrop?.addEventListener('click', closeVideoModal);
	videoModalPrev?.addEventListener('click', () => moveVideoModal(-1));
	videoModalNext?.addEventListener('click', () => moveVideoModal(1));

	websiteCards.forEach(card => {
		card.addEventListener('click', () => {
			const target = card as HTMLElement;
			const index = Number(target.dataset.websiteIndex);
			if (Number.isNaN(index)) return;
			openWebsiteModal(index, target);
		});

		card.addEventListener('keydown', (event: KeyboardEvent) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			const target = card as HTMLElement;
			const index = Number(target.dataset.websiteIndex);
			if (Number.isNaN(index)) return;
			openWebsiteModal(index, target);
		});
	});

	const copyText = async (text: string) => {
		if (navigator.clipboard?.writeText) {
			await navigator.clipboard.writeText(text);
			return;
		}

		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'absolute';
		textarea.style.left = '-9999px';
		document.body.appendChild(textarea);
		textarea.select();
		document.execCommand('copy');
		document.body.removeChild(textarea);
	};

	const projectBriefButton = document.getElementById('copy-project-brief');
	const projectBriefStatus = document.getElementById('project-brief-status');
	const generalContactButton = document.getElementById('copy-general-contact');
	const generalContactStatus = document.getElementById('general-contact-status');

	projectBriefButton?.addEventListener('click', async () => {
		const name = (document.getElementById('project-name') as HTMLInputElement | null)?.value.trim() || 'Name not provided';
		const brand = (document.getElementById('project-brand') as HTMLInputElement | null)?.value.trim() || 'Brand not provided';
		const service = (document.getElementById('project-service') as HTMLSelectElement | null)?.value || 'Not specified';
		const timeline = (document.getElementById('project-timeline') as HTMLSelectElement | null)?.value || 'Not specified';
		const budget = (document.getElementById('project-budget') as HTMLSelectElement | null)?.value || 'Not specified';
		const brief = (document.getElementById('project-brief') as HTMLTextAreaElement | null)?.value.trim() || 'No brief added yet.';

		const message = [
			'PROJECT BRIEF',
			`Name: ${name}`,
			`Brand: ${brand}`,
			`Need: ${service}`,
			`Timeline: ${timeline}`,
			`Budget: ${budget}`,
			'',
			'Brief:',
			brief,
		].join('\n');

		try {
			await copyText(message);
			if (projectBriefStatus) {
				projectBriefStatus.textContent = 'Project brief copied. Paste it into email, WhatsApp, or your favorite channel.';
			}
		} catch {
			if (projectBriefStatus) {
				projectBriefStatus.textContent = 'Copy failed. You can still select the text from the form and share it manually.';
			}
		}
	});

	generalContactButton?.addEventListener('click', async () => {
		const name = (document.getElementById('contact-name') as HTMLInputElement | null)?.value.trim() || 'Name not provided';
		const topic = (document.getElementById('contact-topic') as HTMLSelectElement | null)?.value || 'General question';
		const messageBody = (document.getElementById('contact-message') as HTMLTextAreaElement | null)?.value.trim() || 'No message added yet.';

		const message = [
			'CONTACT NOTE',
			`Name: ${name}`,
			`Topic: ${topic}`,
			'',
			'Message:',
			messageBody,
		].join('\n');

		try {
			await copyText(message);
			if (generalContactStatus) {
				generalContactStatus.textContent = 'Contact note copied. Paste it into email, DM, or WhatsApp.';
			}
		} catch {
			if (generalContactStatus) {
				generalContactStatus.textContent = 'Copy failed. You can still copy the text from the form manually.';
			}
		}
	});

	websiteModalClose?.addEventListener('click', closeWebsiteModal);
	websiteModalBackdrop?.addEventListener('click', closeWebsiteModal);

	document.addEventListener('keydown', (event: KeyboardEvent) => {
		if (contactModalOpen) {
			if (event.key === 'Escape') {
				closeContactModal();
			}
			return;
		}

		if (videoModalOpen) {
			if (event.key === 'Escape') {
				closeVideoModal();
				return;
			}

			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				moveVideoModal(-1);
			}

			if (event.key === 'ArrowRight') {
				event.preventDefault();
				moveVideoModal(1);
			}
			return;
		}

		if (websiteModalOpen) {
			if (event.key === 'Escape') {
				closeWebsiteModal();
			}
			return;
		}

		if (!flyerModalOpen) return;

		if (event.key === 'Escape') {
			closeFlyerModal();
			return;
		}

		if (event.key === 'ArrowLeft') {
			event.preventDefault();
			moveFlyerModal(-1);
		}

		if (event.key === 'ArrowRight') {
			event.preventDefault();
			moveFlyerModal(1);
		}
	});
</script>
